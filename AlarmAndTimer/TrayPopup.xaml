<Window x:Class="AlarmAndTimer.TrayPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlarmAndTimer"
        mc:Ignorable="d"
        Title="TrayPopup" Height="300" Width="250"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="White"
        BorderBrush="#CCCCCC"
        BorderThickness="3"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="Window_Deactivated">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="⏱️ 나의 타이머" FontSize="16" FontWeight="Bold" Margin="0,0,0,10" Foreground="#333333"/>
        <Line Grid.Row="0" X1="0" X2="230" Y1="0" Y2="0" 
              Stroke="#CCCCCC" StrokeThickness="1" 
              StrokeDashArray="4 4" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,10">
            <TextBox x:Name="TimerInput" Width="80" Height="26" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Text="60" FontSize="13"/>
            <TextBlock Text="초 후" VerticalAlignment="Center" Margin="5,0,10,0" Foreground="#555555" FontSize="13"/>
            <Button Content="시작" Width="60" Height="26" Click="StartTimer_Click" Background="#F5F5F5" BorderBrush="#CCCCCC" Cursor="Hand"/>
        </StackPanel>
        <Line Grid.Row="1" X1="0" X2="230" Y1="0" Y2="0" 
              Stroke="#CCCCCC" StrokeThickness="1" 
              StrokeDashArray="4 4" VerticalAlignment="Bottom" Margin="0,0,0,12"/>
        <ListView Grid.Row="2" x:Name="TimerListView" BorderBrush="Transparent" Background="Transparent" HorizontalContentAlignment="Stretch" Margin="0,5,0,0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <TextBlock Text="{Binding TimeLeftString}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                        <Button Content="삭제" Padding="5,2" FontSize="11" HorizontalAlignment="Right" Click="DeleteTimer_Click" Background="#FFF0F0" BorderBrush="#FFE0E0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
