<Window x:Class="AlarmAndTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlarmAndTimer"
        mc:Ignorable="d"
        Title="{DynamicResource AppTitle}" Height="300" Width="350"
        WindowStyle="None"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        Closed="ClosedMainWindow"
        
        Background="{DynamicResource BackgroundColor}"
        BorderBrush="#CCCCCC"
        BorderThickness="2">
    <Window.ContextMenu>
        <ContextMenu Opened="ContextMenu_Opened">
            <MenuItem Name="MakeTimerContextMenu" Header="{DynamicResource Menu_MakeTimer}" Click="OpenTimerPanel_Click" />
            <MenuItem Name="MakeAlarmContextMenu" Header="{DynamicResource Menu_MakeAlarm}" Click="OpenAlarmPanel_Click" />
            <Separator />
            <MenuItem Header="{DynamicResource Menu_Settings}" Click="Settings_Click" />
            <MenuItem Header="{DynamicResource Menu_Language}" Name="LanguageSet">
                <MenuItem Header="한국어" Name="Korean" IsCheckable="True" Click="ChangeLanguage" />
                <MenuItem Header="English" Name="English" IsCheckable="True" Click="ChangeLanguage" />
            </MenuItem>
            <MenuItem Header="{DynamicResource Menu_ManageScript}" Click="MangeScript_Click"/>
            <MenuItem Header="{DynamicResource Menu_LoadScript}" Click="LoadScript_Click" />
            <Separator />
            <MenuItem Header="{DynamicResource Menu_AlwaysOnTop}" Name="AlwaysTopContextMenu" IsCheckable="True" Checked="AlwaysTop_Checked" Unchecked="AlwaysTop_Unchecked" />
            <MenuItem Header="{DynamicResource Menu_SendToTray}" Click="TrayMenu_HyperLink" />
            <MenuItem Header="{DynamicResource Menu_HideTaskbar}" Click="HideFromTaskBar" />
            <MenuItem Header="{DynamicResource Menu_Minimize}" Click="Minimize_HyperLink" />
            <MenuItem Header="{DynamicResource Menu_Exit}" Click="CompletelyClose_HyperLink" />
        </ContextMenu>
    </Window.ContextMenu>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
            <Setter Property="FontSize" Value="{Binding DataContext.MyFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="FontSize" Value="{Binding DataContext.MyFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="{Binding DataContext.MyFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">

                <CheckBox Name="AlwaysTop_CheckBox"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsAlwaysTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Checked="AlwaysTop_Checked"
                          Unchecked="AlwaysTop_Unchecked"
                          Margin="0,0,-7,0"/>
                <TextBlock Margin="10,0,10,0"
                           VerticalAlignment="Center">
                    <Hyperlink Click="AlwaysTop_HyperLink">항상위 고정</Hyperlink>
                </TextBlock>
                <TextBlock Margin="10,0,10,0"
                           VerticalAlignment="Center">
                    <Hyperlink Click="TrayMenu_HyperLink">트레이 보내기</Hyperlink>
                </TextBlock>
                <TextBlock Margin="10,0,10,0"
                           VerticalAlignment="Center">
                    <Hyperlink Click="Minimize_HyperLink">최소화</Hyperlink>
                </TextBlock>
                <TextBlock Margin="10,0,10,0"
                           VerticalAlignment="Center">
                    <Hyperlink Click="CompletelyClose_HyperLink">완전히 종료</Hyperlink>
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Visibility="{Binding IsShowTime, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{DynamicResource CurrentTime}"></TextBlock>
                <TextBlock Text=" "></TextBlock>
                <TextBlock Grid.Row="0" HorizontalAlignment="Center"
                           Text="{Binding CurrentTime}"
                           FontWeight="Bold"
                           FontSize="{Binding MyFontSize}">
                </TextBlock>
            </StackPanel>
            <ListView
                    Grid.Row="1"
                    x:Name="TimerListView"
                    BorderBrush="Transparent"
                    Background="Transparent"
                    HorizontalContentAlignment="Stretch"
                    Margin="0,5,0,0"
    
                    ItemsSource="{Binding Timers}"
                    d:DataContext="{d:DesignInstance Type=local:DesignViewModel, IsDesignTimeCreatable=True}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <!--DataTemplate.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="FontSize" Value="{Binding DataContext.MyFontSize, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Style>
                        </DataTemplate.Resources-->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                    Text="{Binding TimeLeftString}" 
                                    FontSize="{Binding DataContext.MyFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                    FontWeight="Bold"
                                    Margin="0,0,15,0"
                                    Foreground="{Binding CurrentColor}"
                                    VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                    Text="{Binding EndTimeString, StringFormat='종료: {0}'}" 
                                    FontSize="{Binding DataContext.MyFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Foreground="Gray"
                                    VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                    Foreground="{DynamicResource TextColor}"
                                    FontSize="{Binding DataContext.MyFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Text="{Binding TimerMemo}"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"/>

                            <!--
                            <Button Grid.Column="3"
                                    Click="PauseTimer_Click"
                                    Content="{Binding PauseButtonText}"
                                    Padding="5,2"
                                    FontSize="11"
                                    Margin="0,0,5,0"
                                    Background="#FFF0F0"
                                    BorderBrush="#FFE0E0"
                                    VerticalAlignment="Center"/>
                            -->

                            <Button Grid.Column="3"
                                    Click="DeleteTimer_Click"
                                    Content="{DynamicResource Make_Btn_Delete}"
                                    Padding="5,2"
                                    FontSize="{Binding DataContext.MyFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Background="#FFF0F0"
                                    BorderBrush="#FFE0E0"
                                    VerticalAlignment="Center"/>

                            <Button Grid.Column="4"
                                    Click="MoveUp_Click"
                                    Tag="{Binding}"
                                    Content="▲"
                                    Padding="3,2"
                                    Margin="4,0"
                                    FontSize="{Binding DataContext.MyFontSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Background="#FFF0F0"
                                    BorderBrush="#FFE0E0"
                                    VerticalAlignment="Center"/>

                            <Button Grid.Column="5"
                                    Click="MoveDown_Click"
                                    Tag="{Binding}"
                                    Content="▼"
                                    Padding="3,2"
                                    FontSize="{Binding DataContext.MyFontSize, 
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                    Background="#FFF0F0"
                                    BorderBrush="#FFE0E0"
                                    VerticalAlignment="Center"/>

                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Row="1"
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource StartWithRightClick}" 
                               Foreground="Gray"
                               FontSize="16"
                               HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=TimerListView}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{DynamicResource StartWithRightClickSub}" 
                               Foreground="Gray"
                               FontSize="13"
                               HorizontalAlignment="Center">       
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, ElementName=TimerListView}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Name="MakePanelBackground"
              Visibility="Hidden">
            <Border Name="MakePanelBackgroundBorder" Background="#1A000000" />
        </Grid>
        <StackPanel Name="MakePanel" VerticalAlignment="Bottom" Visibility="Hidden">
            <StackPanel.Effect>
                <DropShadowEffect 
                    Color="Gray" 
                    BlurRadius="30" 
                    ShadowDepth="1" 
                    Opacity="0.3" 
                    Direction="90" />
            </StackPanel.Effect>
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="MoveTransform" Y="50" />
            </StackPanel.RenderTransform>
            <Border Background="White" CornerRadius="10, 10, 0, 0">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0, 30, 0, 30">
                    <StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Button
                                    Name="AmPmButton"
                                    Content=""
                                    Width="30"
                                    Click="ToggleAmPm_Click"
                                    Visibility="Collapsed"
                                    Margin="0,0,4,0" />
                                <TextBox Grid.Column="0" 
                                    Name="HourInput"
                                    Width="30"
                                    VerticalContentAlignment="Center"/>

                                <Grid Grid.Column="1" Width="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Button Grid.Row="0" Content="▲" FontSize="8" Padding="0" Click="HourUpButton_Click" />
                                    <Button Grid.Row="1" Content="▼" FontSize="8" Padding="0" Click="HourDownButton_Click" />
                                </Grid>

                                <TextBlock Grid.Column="2" Text="{DynamicResource Label_Hour}" VerticalAlignment="Center" Margin="2,0,2,0" Foreground="#555555" FontSize="13"/>
                                <TextBlock Name="GanTextBlock" Grid.Column="2" Text="{DynamicResource Label_Duration}" VerticalAlignment="Center" Margin="-2,0,2,0" Foreground="#555555" FontSize="13"/>

                                <TextBox Grid.Column="3" 
                                    Name="MinuteInput"
                                    Width="30" 
                                    VerticalContentAlignment="Center"/>

                                <Grid Grid.Column="4" Width="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Button Grid.Row="0" Content="▲" FontSize="8" Padding="0" Click="MinuteUpButton_Click" />
                                    <Button Grid.Row="1" Content="▼" FontSize="8" Padding="0" Click="MinuteDownButton_Click" />
                                </Grid>

                                <TextBlock Grid.Column="5" Text="{DynamicResource Label_Minute}" VerticalAlignment="Center" Margin="2,0,2,0" Foreground="#555555" FontSize="13"/>

                                <TextBox Grid.Column="6" 
                                    Name="SecondInput"
                                    Width="30" 
                                    VerticalContentAlignment="Center"/>

                                <Grid Grid.Column="7" Width="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Button Grid.Row="0" Content="▲" FontSize="8" Padding="0" Click="SecondUpButton_Click" />
                                    <Button Grid.Row="1" Content="▼" FontSize="8" Padding="0" Click="SecondDownButton_Click" />
                                </Grid>

                                <TextBlock Name="TimerTail" Grid.Column="8" Text="{DynamicResource Label_AfterTimer}" VerticalAlignment="Center" Margin="2,0,2,0" Foreground="#555555" FontSize="13" Visibility="Collapsed"/>
                                <TextBlock Name="AlarmTail" Grid.Column="8" Text="{DynamicResource Label_AtAlarm}" VerticalAlignment="Center" Margin="2,0,2,0" Foreground="#555555" FontSize="13" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="#555555" Text="{DynamicResource Make_Label_Memo}" />
                            <TextBox
                                Name="Memo"
                                Grid.Column="1"
                                MinWidth="120" />
                        </Grid>
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Name="StartButton" Content="{DynamicResource Make_Btn_Create}" Click="StartButton_Click"></Button>
                            <Button Margin="6,0,0,0" Content="{DynamicResource Make_Btn_Cancel}" Click="MakeCancel_Click"></Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
        <Border Name="AlarmBreakingNotice" Background="{DynamicResource BackgroundColor}" Opacity="0.5" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" >
                <Border Background="{DynamicResource BackgroundColor}" Padding="10 5">
                    <Grid>
                        <TextBlock Text="{DynamicResource Str_ClickToStopAlarm}"
                                   FontSize="15"
                                   FontWeight="Bold" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
