<Window x:Class="AlarmAndTimer.ScriptManager"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlarmAndTimer"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="{DynamicResource Title_ScriptManager}" Height="450" Width="605">
    <Grid Background="#efefef">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="90"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Margin="18,18,18,18" Background="#ffffff">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Name="TimerList" Orientation="Vertical">
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid Grid.Column="1">
            <Grid Margin="0,18,18,18">
                <StackPanel Orientation="Vertical">
                    <Button Content="{DynamicResource Btn_Save}" Click="SaveScript" />
                    <Button Content="{DynamicResource Btn_Load}" Margin="0,10,0,0" Click="LoadScript" />
                    <Button Content="{DynamicResource Btn_AddRow}" Margin="0,40,0,0" Click="MakeManageCard"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>