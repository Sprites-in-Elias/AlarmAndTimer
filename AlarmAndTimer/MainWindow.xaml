<Window x:Class="AlarmAndTimer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlarmAndTimer"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="350"
        WindowStyle="None"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseMove="Window_MouseMove"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        
        Background="{DynamicResource BackgroundColor}"
        BorderBrush="#CCCCCC"
        BorderThickness="2">
    <Window.ContextMenu>
        <ContextMenu Opened="ContextMenu_Opened">
            <MenuItem Name="MakeTimerContextMenu" Header="타이머 생성" Click="OpenTimerPanel_Click" />
            <MenuItem Name="MakeAlarmContextMenu" Header="알람 생성" Click="OpenAlarmPanel_Click" />
            <Separator />
            <MenuItem Header="설정(Settings)" Click="Settings_Click" />
            <MenuItem Header="스크립트 관리" Click="MangeScript_Click"/>
            <MenuItem Header="스크립트 불러오기" Click="LoadScript_Click" />
            <!--<MenuItem Header="임시" Click="ContextMenuTempButton_Click" />-->
            <Separator />
            <MenuItem Header="항상 위" 
                  Name="AlwaysTopContextMenu"
                  IsCheckable="True"
                  Checked="AlwaysTop_Checked" 
                  Unchecked="AlwaysTop_Unchecked" />
            <MenuItem Header="트레이로 보내기" Click="TrayMenu_HyperLink" />
            <MenuItem Header="시작표시줄에서 숨기기" Click="HideFromTaskBar" />
            <MenuItem Header="최소화" Click="Minimize_HyperLink" />
            <MenuItem Header="완전히 종료" Click="CompletelyClose_HyperLink" />
        </ContextMenu>
    </Window.ContextMenu>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Visibility="Collapsed">

                <CheckBox Name="AlwaysTop_CheckBox"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsAlwaysTop, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Checked="AlwaysTop_Checked"
                          Unchecked="AlwaysTop_Unchecked"
                          Margin="0,0,-7,0"/>
                <TextBlock Margin="10,0,10,0"
                           VerticalAlignment="Center">
                    <Hyperlink Click="AlwaysTop_HyperLink">항상위 고정</Hyperlink>
                </TextBlock>
                <TextBlock Margin="10,0,10,0"
                           VerticalAlignment="Center">
                    <Hyperlink Click="TrayMenu_HyperLink">트레이 보내기</Hyperlink>
                </TextBlock>
                <TextBlock Margin="10,0,10,0"
                           VerticalAlignment="Center">
                    <Hyperlink Click="Minimize_HyperLink">최소화</Hyperlink>
                </TextBlock>
                <TextBlock Margin="10,0,10,0"
                           VerticalAlignment="Center">
                    <Hyperlink Click="CompletelyClose_HyperLink">완전히 종료</Hyperlink>
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Visibility="{Binding IsShowTime, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="현재시각 "></TextBlock>
                <TextBlock Grid.Row="0" HorizontalAlignment="Center"
                           Text="{Binding CurrentTime}"
                           FontWeight="Bold"
                           FontSize="13">
                </TextBlock>
            </StackPanel>
            <ListView
                    Grid.Row="1"
                    x:Name="TimerListView"
                    BorderBrush="Transparent"
                    Background="Transparent"
                    HorizontalContentAlignment="Stretch"
                    Margin="0,5,0,0"
    
                    ItemsSource="{Binding Timers}"
                    d:DataContext="{d:DesignInstance Type=local:DesignViewModel, IsDesignTimeCreatable=True}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                    Text="{Binding TimeLeftString}" 
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Margin="0,0,15,0"
                                    Foreground="{Binding CurrentColor}"
                                    VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                    Text="{Binding EndTimeString, StringFormat='종료: {0}'}" 
                                    FontSize="12"
                                    Foreground="Gray"
                                    VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                                    Text="{Binding TimerMemo}"/>

                            <!--
                            <Button Grid.Column="3"
                                    Click="PauseTimer_Click"
                                    Content="{Binding PauseButtonText}"
                                    Padding="5,2"
                                    FontSize="11"
                                    Margin="0,0,5,0"
                                    Background="#FFF0F0"
                                    BorderBrush="#FFE0E0"
                                    VerticalAlignment="Center"/>
                            -->

                            <Button Grid.Column="3"
                                    Click="DeleteTimer_Click"
                                    Content="삭제"
                                    Padding="5,2"
                                    FontSize="11"
                                    Background="#FFF0F0"
                                    BorderBrush="#FFE0E0"
                                    VerticalAlignment="Center"/>

                            <Button Grid.Column="4"
                                    Click="MoveUp_Click"
                                    Tag="{Binding}"
                                    Content="▲"
                                    Padding="3,2"
                                    Margin="4,0"
                                    FontSize="10"
                                    Background="#FFF0F0"
                                    BorderBrush="#FFE0E0"
                                    VerticalAlignment="Center"/>

                            <Button Grid.Column="5"
                                    Click="MoveDown_Click"
                                    Tag="{Binding}"
                                    Content="▼"
                                    Padding="3,2"
                                    FontSize="10"
                                    Background="#FFF0F0"
                                    BorderBrush="#FFE0E0"
                                    VerticalAlignment="Center"/>

                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <Grid Grid.Row="1"
                   VerticalAlignment="Center" 
                   HorizontalAlignment="Center">
                <TextBlock Text="마우스 우클릭으로 시작하세요" 
                   Foreground="Gray"
                   FontSize="16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=TimerListView}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
        <StackPanel Name="AddButtonPackage" VerticalAlignment="Bottom" HorizontalAlignment="Right" Visibility="Hidden">

            <StackPanel x:Name="SubButtonsPanel" Visibility="Collapsed" Margin="0,0,0,10">
                <Button Content="설정" Height="30" Margin="0,5"/>
                <Button Content="로드" Height="30" Margin="0,5"/>
                <Button Content="알람" Height="30" Margin="0,5" Click="OpenAlarmPanel_Click"/>
                <Button Content="타이머" Height="30" Margin="0,5" Click="OpenTimerPanel_Click"/>
            </StackPanel>

            <Button Content="+" Width="50" Height="50" Click="AddButton_Click"/>
        </StackPanel>
        <Grid Name="MakePanelBackground"
              Visibility="Hidden">
            <Border Name="MakePanelBackgroundBorder" Background="#1A000000" />
        </Grid>
        <StackPanel Name="MakePanel" VerticalAlignment="Bottom" Visibility="Hidden">
            <StackPanel.Effect>
                <DropShadowEffect 
                    Color="Gray" 
                    BlurRadius="30" 
                    ShadowDepth="1" 
                    Opacity="0.3" 
                    Direction="90" />
            </StackPanel.Effect>
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="MoveTransform" Y="50" />
            </StackPanel.RenderTransform>
            <Border Background="White" CornerRadius="10, 10, 0, 0">
                <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0, 30, 0, 30">
                    <StackPanel>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                <Button
                                    Name="AmPmButton"
                                    Content=""
                                    Width="30"
                                    Click="ToggleAmPm_Click"
                                    Visibility="Collapsed"
                                    Margin="0,0,4,0" />
                                <TextBox Grid.Column="0" 
                                    Name="HourInput"
                                    Width="30"
                                    VerticalContentAlignment="Center"/>

                                <Grid Grid.Column="1" Width="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Button Grid.Row="0" Content="▲" FontSize="8" Padding="0" Click="HourUpButton_Click" />
                                    <Button Grid.Row="1" Content="▼" FontSize="8" Padding="0" Click="HourDownButton_Click" />
                                </Grid>

                                <TextBlock Grid.Column="2" Text="시" VerticalAlignment="Center" Margin="2,0,2,0" Foreground="#555555" FontSize="13"/>
                                <TextBlock Name="GanTextBlock" Grid.Column="2" Text="간" VerticalAlignment="Center" Margin="-2,0,2,0" Foreground="#555555" FontSize="13"/>

                                <TextBox Grid.Column="3" 
                                    Name="MinuteInput"
                                    Width="30" 
                                    VerticalContentAlignment="Center"/>

                                <Grid Grid.Column="4" Width="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Button Grid.Row="0" Content="▲" FontSize="8" Padding="0" Click="MinuteUpButton_Click" />
                                    <Button Grid.Row="1" Content="▼" FontSize="8" Padding="0" Click="MinuteDownButton_Click" />
                                </Grid>

                                <TextBlock Grid.Column="5" Text="분" VerticalAlignment="Center" Margin="2,0,2,0" Foreground="#555555" FontSize="13"/>

                                <TextBox Grid.Column="6" 
                                    Name="SecondInput"
                                    Width="30" 
                                    VerticalContentAlignment="Center"/>

                                <Grid Grid.Column="7" Width="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <Button Grid.Row="0" Content="▲" FontSize="8" Padding="0" Click="SecondUpButton_Click" />
                                    <Button Grid.Row="1" Content="▼" FontSize="8" Padding="0" Click="SecondDownButton_Click" />
                                </Grid>

                                <TextBlock Name="TimerTail" Grid.Column="8" Text="초 후" VerticalAlignment="Center" Margin="2,0,2,0" Foreground="#555555" FontSize="13" Visibility="Collapsed"/>
                                <TextBlock Name="AlarmTail" Grid.Column="8" Text="초에" VerticalAlignment="Center" Margin="2,0,2,0" Foreground="#555555" FontSize="13" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="메모 : " />
                            <TextBox
                                Name="Memo"
                                Grid.Column="1"
                                MinWidth="120" />
                        </Grid>
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Name="StartButton" Content="만들기" Click="StartButton_Click"></Button>
                            <Button Margin="6,0,0,0" Content="취소" Click="MakeCancel_Click"></Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
